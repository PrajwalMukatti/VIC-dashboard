<mvc:View controllerName="vicstartintegration.controller.View1"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:f="sap.f" 
    xmlns:layout="sap.ui.layout"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar" 
    xmlns:fb="sap.ui.comp.filterbar" 
    xmlns:tnt="sap.tnt"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">

   <f:DynamicPage id="page1" class="sapUiSizeCompact">

      <f:header>
        <f:DynamicPageHeader id='dynamicpage' pinnable="true">
     <fb:FilterBar id="idFilterBar" showGoOnFB="true" showClearOnFB="true" showRestoreOnFB="false" showFilterConfiguration="true" persistencyKey="myPersKey"
					search="onFBGoPress" clear="onFBClearPress" reset="onFBResetPress" useToolbar="false">
    <fb:filterGroupItems>
    	<fb:FilterGroupItem id='item1' groupName="__$INTERNAL$" name="A" label="Search" visibleInFilterBar="true">
							<fb:control>
								<SearchField id="idSearchField" placeholder="Search" showSearchButton="true" width="auto" search="onSearchFieldPress"/>
							</fb:control>
		</fb:FilterGroupItem>
        <fb:FilterGroupItem id='item2' groupName="__$INTERNAL$" name="B" label="Test Plan " labelTooltip="Test plans" visibleInFilterBar="true">
							<fb:control>
								<MultiInput id="idMInpTestPlan" valueHelpRequest="onTestPlanVH"></MultiInput>
							</fb:control>
		</fb:FilterGroupItem>
		<fb:FilterGroupItem groupName="__$INTERNAL$" name="G" label="Test Type " visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox id="idMCBoxTestScope" width="auto" selectionFinish="onTestTypeChange" items="{path :'mTesScp>/' , templateShareable:false}">
									<items>
										<core:Item text="{ path:'mTesScp>TestType' }" enabled="true" key="{ path:'mTesScp>TestType' }"/>
									</items>
								</MultiComboBox>
							</fb:control>
		</fb:FilterGroupItem>
		<fb:FilterGroupItem groupName="__$INTERNAL$" name="H" label="Similarity % " visibleInFilterBar="true" change="onSimilatitySelect">
							<fb:control>
								<MultiComboBox id="idMCBoxsimilarity" width="auto" items="{path : 'mSimilarity>/similaritySet' , templateShareable:false}">
									<items>
										<core:Item key="{path:  'mSimilarity>Description' }" enabled="true" text="{ path : 'mSimilarity>Description' }" />
									</items>
								</MultiComboBox>
							</fb:control>
		</fb:FilterGroupItem>
        <fb:FilterGroupItem id='item3' groupName="__$INTERNAL$" name="E" label="Product Area " visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox id="idMCBoxProdArea" width="auto" selectionFinish="onProductAreaChange" items="{path :'mProdArea>/' , templateShareable:false}">
									<items>
										<core:Item text="{ path:'mProdArea>ProductArea' }" enabled="true" key="{ path:'mProdArea>ProductArea' }"/>
									</items>
								</MultiComboBox>
							</fb:control>
		</fb:FilterGroupItem>
		<fb:FilterGroupItem groupName="__$INTERNAL$" name="R" label="Release" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox id="idMCBoxRelease" width="auto" selectionFinish="onReleaseChange" items="{path :'mRelease>/' , templateShareable:false}">
									<items>
										<core:Item text="{ path:'mRelease>Release' }" enabled="true" key="{ path:'mRelease>Release' }"/>
									</items>
								</MultiComboBox>
							</fb:control>
		</fb:FilterGroupItem>
		<fb:FilterGroupItem groupName="__$INTERNAL$" name="U" label="UI5 Version" visibleInFilterBar="true">
							<fb:control>
								<MultiComboBox id="idMCBoxUI5Version" width="auto" selectionFinish="onUI5VersionChange" items="{path :'mUI5Version>/' , templateShareable:false}">
									<items>
										<core:Item text="{ path:'mUI5Version>UI5Version' }" enabled="true" key="{ path:'mUI5Version>UI5Version' }"/>
									</items>
								</MultiComboBox>
							</fb:control>
		</fb:FilterGroupItem>
    </fb:filterGroupItems>              
    </fb:FilterBar>
     </f:DynamicPageHeader>
      </f:header>

      <f:content>
         <VBox class="sapUiContentPadding" fitContainer="true">

            <!-- Toolbar with toggle buttons -->
            <OverflowToolbar>
               <ToolbarSpacer/>
               <SegmentedButton id="viewSwitch" selectedKey="{view>/view}" selectionChange="onViewChange">
                  <items>
                     <SegmentedButtonItem text="Chart View" key="chart" icon="sap-icon://bar-chart" tooltip="Switch to Chart View"/>
                     <SegmentedButtonItem text="Table View" key="table" icon="sap-icon://table-view" tooltip="Switch to Table View"/>
                  </items>
               </SegmentedButton>
               <!-- <ToolbarSeparator/>
               <Label text="Live"/>
               <Switch state="{state>/liveMode}" change="onToggleLive" />
               <ToolbarSeparator/> -->
               <Select id="chartTypeSelect" selectedKey="{state>/chartType}" change="onChartTypeChange" width="200px">
                  <items>
                     <core:Item key="pie" text="Pie"/>
                     <core:Item key="donut" text="Donut"/>
                     <core:Item key="column" text="Column"/>
                     <core:Item key="bar" text="Bar"/>
                     <core:Item key="line" text="Line"/>
                     <core:Item key="stacked_column" text="Stacked Column"/>
                     <core:Item key="stacked_bar" text="Stacked Bar"/>
                  </items>
               </Select>
               <!-- <ToggleButton id="navToggle" text="Chart Click → Navigate" pressed="{state>/chartNavEnabled}" press="onToggleChartNav"/> -->
               <Button icon="sap-icon://excel-attachment" tooltip="Export to Excel" press="onExport" />
            </OverflowToolbar>

    <!-- Chart Section -->
<VBox visible="{= ${view>/view}==='chart'}" class="sapUiSmallMarginTop">
   <viz:Popover id="idPopOver"></viz:Popover>
   <viz:VizFrame id="mainViz"
                 uiConfig="{applicationSet:'fiori'}"
                 height="420px"
                 width="100%"
                 vizType="{state>/chartType}"
                 selectData="onChartSelect">
      <viz:dataset>
         <!-- Bind to PieChartData instead of msimilaritypercent -->
         <viz.data:FlattenedDataset data="{mock>/PieChartData}">
            <viz.data:dimensions>
               <!-- Status = category (<96%, 96-98%, etc.) -->
               <viz.data:DimensionDefinition name="Similarity Category" value="{mock>Status}" />
            </viz.data:dimensions>
            <viz.data:measures>
               <!-- Count = number of records -->
               <viz.data:MeasureDefinition name="TestPlan" value="{mock>Count}" />
            </viz.data:measures>
         </viz.data:FlattenedDataset>
      </viz:dataset>

<viz:feeds>
    <vizFeeds:FeedItem uid="size" type="Measure" values="TestPlan" />
    <vizFeeds:FeedItem uid="color" type="Dimension" values="Similarity Category" />
</viz:feeds>

   </viz:VizFrame>
</VBox>


            <!-- Table Section -->
			 <VBox visible="{= ${view>/view}==='table'}" class="sapUiSmallMarginTop">
             <Table id='idTblTestPlan'  width="auto" showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true"
				alternateRowColors="true" sticky="HeaderToolbar,InfoToolbar,ColumnHeaders" items="{ path: 'msimilaritypercent>/', templateShareable: false }" enableBusyIndicator="true"
				updateFinished="onTblUpdateFinished">
	    <headerToolbar>
					<OverflowToolbar width="auto" height="auto" design="Transparent">
						<content>
							<Title id="idTblTitle" text="Test Plans" titleStyle="Auto" width="auto" textAlign="Begin" wrapping="false"/>
							<ToolbarSpacer/>
							<OverflowToolbarButton id="compareBtn" type="Transparent" icon="sap-icon://compare" iconFirst="true" width="auto" tooltip="Compare"
				iconDensityAware="false" press="oCompareButton"/>
							<OverflowToolbarButton icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refreshLogs}" press="onLogsRefresh"/>
							<OverflowToolbarButton tooltip="Sort" icon="sap-icon://sort" press="handleSortButtonPressed"/>
							<OverflowToolbarButton type="Transparent" icon="sap-icon://excel-attachment" iconFirst="true" width="auto" tooltip="Export to Excel"
								iconDensityAware="false" press="onExport"/>
							<OverflowToolbarButton id='bar6' type="Transparent" icon="sap-icon://action-settings" iconFirst="true" width="auto" tooltip="Settings"
								iconDensityAware="false" press="onPersoButtonPressed"/>
								
						</content>
					</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column id="testPlan1" width="auto" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<header>
					<Text text="Test Plan" wrapping="true"/>
				</header>
			</Column>
			<Column id="productArea" width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<header>
					<Text text="Product Area" wrapping="true"/>
				</header>
			</Column>
			<Column id="testScope" width="10%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<header>
					<Text text="Test Type" wrapping="true"/>
				</header>
			</Column>
			<Column id="analysedDate" width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<header>
					<Text text="Compared on" wrapping="true"/>
				</header>
			</Column>
			<Column id="similarity" width="15%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
				<header>
					<Text text="Similarity %" wrapping="true"/>
				</header>
			</Column>
		</columns>
		<items>
			<ColumnListItem type="Navigation" press="onLogRowPress">
				<cells>
				    <Text text="{msimilaritypercent>testPlanName}"/>
					<Text text="{msimilaritypercent>ProductArea}"/>
					<Text text="{msimilaritypercent>TestType}"/>
					<Text text="{msimilaritypercent>executeOn}"/>
					<Text text="{msimilaritypercent>percentSuccess}%"/>
					
				</cells>
			</ColumnListItem>
		</items>
        </Table>
</VBox>
         </VBox>
      </f:content>
   </f:DynamicPage>
</mvc:View>
