{
  "name": "vicstartintegration",
  "version": "3.1.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.16",
    "@sap/ux-ui5-tooling": "1",
    "ui5-task-zipper": "^3.4.x"
  },
  "scripts": {
    "start": "fiori run --config ./ui5.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#vicstartintegration-display\"",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#vicstartintegration-display\"",
    "start-preview": "fiori run --config ./ui5.yaml --open \"/preview.html#app-preview\"",
    "start-index": "fiori run --config ./ui5.yaml --open \"/index.html?sap-ui-debug=true&sap-ui-xx-viewCache=false\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "iori verify",
    "deploy-config": "fiori add deploy-config",
    "int-test": "fiori run --open 'test/integration/opaTests.qunit.html'",
    "unit-test": "fiori run --open 'test/unit/unitTests.qunit.html'",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo"
  },
  "sapuxLayer": "VENDOR"
}
