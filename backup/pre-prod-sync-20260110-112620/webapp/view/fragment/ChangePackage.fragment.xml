<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog title="Select Package" contentWidth="50%" contentHeight="30%">
		<content>
			<f:SimpleForm id="SimpleFormChange354" layout="ResponsiveGridLayout" editable="true" labelSpanL="2" labelSpanM="2" labelSpanS="12"
				emptySpanL="2" emptySpanM="2" emptySpanS="0">
				<f:content>
					<Label text="Package"></Label>
					<!--<MultiComboBox id="idMCBoxProdArea" width="auto">-->
					<!--	<items>-->
					<!--		<core:Item text="EMC1" enabled="true" key="EMC1"/>-->
					<!--		<core:Item text="EMC2" enabled="true" key="EMC2"/>-->
					<!--		<core:Item text="EMC3" enabled="true" key="EMC3"/>-->
					<!--	</items>-->
					<!--</MultiComboBox>-->
					<MultiComboBox id="idMCBoxPckgDialog" width="auto" items="{path :'mPackageModel>/' , templateShareable:false}">
						<items>
							<core:Item text="{ path:'mPackageModel>spackage' }" enabled="true" key="{ path:'mPackageModel>spackageid' }"/>
						</items>
					</MultiComboBox>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button type="Emphasized" text="Continue" press="handlePackageOKpress"></Button>
		</beginButton>
		<endButton>
			<!--<Button text="Close" press="handlePackageClosepress"></Button>-->
		</endButton>
	</Dialog>
</core:FragmentDefinition>