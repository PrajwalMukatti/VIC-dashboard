<mvc:View controllerName="vicstartintegration.controller.App"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <VBox height="100%">
        <f:ShellBar id="shellBar"
            showNavButton="true"
            navButtonPressed="onShellNavBack"
            title="VIC Dashboard"
            homeIcon="sap-icon://sap-logo-shape"
            showSearch="true"
            showNotifications="false"
            showCopilot="false">
            <f:profile>
                <Avatar id="userAvatar" initials="US" imageFitType="Cover" />
            </f:profile>
        </f:ShellBar>
        <App id="app"/>
    </VBox>
</mvc:View>
